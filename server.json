{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.1019666077-bit/webcam",
  "title": "Webcam MCP",
  "description": "Give LLM agents webcam access: capture photos and record short videos over MCP.",
  "version": "0.2.0",
  "websiteUrl": "https://github.com/1019666077-bit/webcam_mcp",
  "repository": {
    "source": "github",
    "url": "https://github.com/1019666077-bit/webcam_mcp",
    "id": "1413915608"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "botbridge-webcam-mcp",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "valueHint": "package",
          "value": "botbridge-webcam-mcp",
          "description": "PyPI distribution to launch with uvx"
        }
      ],
      "packageArguments": [
        {
          "type": "named",
          "name": "--port",
          "default": "8000",
          "description": "HTTP port for the SSE endpoint"
        }
      ],
      "transport": {
        "type": "sse",
        "url": "http://localhost:8000/sse"
      }
    }
  ]
}
